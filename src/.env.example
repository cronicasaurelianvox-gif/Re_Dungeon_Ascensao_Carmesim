# ════════════════════════════════════════════════════════════
# 🤖 CARDFLUX IA - CONFIGURAÇÃO AMBIENTE
# ════════════════════════════════════════════════════════════

# PORT - Porta do servidor
PORT=3000

# ════════════════════════════════════════════════════════════
# IA PROVIDERS
# ════════════════════════════════════════════════════════════

# Anthropic (Claude)
# Obter em: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT)
# Obter em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ════════════════════════════════════════════════════════════
# CORS - URLs permitidas
# ════════════════════════════════════════════════════════════

# Separar múltiplas URLs com vírgula
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,file://

# ════════════════════════════════════════════════════════════
# NOTAS
# ════════════════════════════════════════════════════════════

# 1. NUNCA fazer commit desse arquivo com keys reais!
#    Usar: git update-index --assume-unchanged .env

# 2. Template .env.example deve estar no git (sem keys)

# 3. Em produção, usar variáveis de ambiente do servidor
#    (não arquivo .env)

# 4. Para local development:
#    - Copiar .env.example → .env
#    - Adicionar suas keys
#    - Não fazer commit
